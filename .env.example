# GOOGLE_TRANSLATE_API_KEY / GOOGLE_CLOUD_API_KEY: Recommended primary translation engine.
GOOGLE_TRANSLATE_API_KEY="MY_GOOGLE_TRANSLATE_API_KEY"

# TRANSLATION_PROVIDER: Preferred provider ('cloud-translate' | 'gemini' | 'auto').
TRANSLATION_PROVIDER="auto"

# GEMINI_API_KEY: Secondary AI translation & dictionary analysis engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional production backend server URL (e.g. https://api.lingotwice.com)
# Use when frontend is hosted statically on Hostinger and backend is hosted on Render/Railway/VPS.
VITE_API_BASE_URL=""
