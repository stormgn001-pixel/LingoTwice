rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Vocabulary entries: Only owner can read/write
    match /users/{userId}/vocabulary/{vocabularyId} {
      allow read, write: if isOwner(userId) && isValidId(vocabularyId);
    }

    // Stats: Only owner can read/write
    match /users/{userId}/stats/data {
      allow read, write: if isOwner(userId);
    }
  }
}
